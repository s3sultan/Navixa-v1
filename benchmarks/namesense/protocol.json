{
  "version": 2,
  "evidenceMode": "human",
  "releaseSplit": "holdout",
  "requiredProvenance": "controlled-live",
  "requiredCaptureMethod": "live-microphone",
  "requiredAccents": [
    {"id": "en-IN", "label": "Indian English"},
    {"id": "en-PH", "label": "Filipino English"},
    {"id": "en-US", "label": "American English"},
    {"id": "en-GB", "label": "British English"},
    {"id": "ar-GULF", "label": "Gulf Arabic"},
    {"id": "ar-EG", "label": "Egyptian Arabic"},
    {"id": "ar-SY", "label": "Syrian Arabic"},
    {"id": "ar-MA", "label": "Moroccan Arabic"},
    {"id": "ar-DZ", "label": "Algerian Arabic"}
  ],
  "minimums": {
    "speakersPerAccent": 25,
    "positiveTrialsPerAccent": 500,
    "negativeTrialsPerAccent": 500,
    "minTrialsPerSpeakerPerAccent": 24,
    "minPositiveTrialsPerSpeakerPerAccent": 10,
    "minNegativeTrialsPerSpeakerPerAccent": 10,
    "latencyEligiblePositiveShare": 0.25,
    "latencyCoverage": 0.98,
    "maxSpeakerSharePerAccent": 0.06,
    "requiredCategoryShares": {
      "deviceClass": {
        "laptop-built-in": 0.20,
        "headset": 0.20,
        "phone": 0.20
      },
      "browser": {
        "desktop-chromium": 0.25,
        "ios-safari": 0.25
      },
      "noise": {
        "clean": 0.20,
        "office-background": 0.20,
        "lecture-echo": 0.20
      }
    }
  },
  "thresholds": {
    "overallRecall": 0.98,
    "overallRecallLower95": 0.97,
    "perAccentRecall": 0.97,
    "perAccentRecallLower95": 0.95,
    "overallFalsePositiveRate": 0.005,
    "overallFalsePositiveUpper95": 0.0075,
    "perAccentFalsePositiveRate": 0.01,
    "perAccentFalsePositiveUpper95": 0.02,
    "p95LatencyMs": 1500
  },
  "latency": {
    "boundary": "client-vad-name-end-to-alert",
    "clock": "performance.now",
    "eligiblePrompts": "name-only-or-name-final",
    "includesRecognitionRuntime": true,
    "includesUiAlertDispatch": true,
    "excludesSetupAndPermissionTime": true
  }
}
