{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "navixa-plan-b",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "r2_buckets": [
    {
      "binding": "STATE",
      "bucket_name": "navixa-plan-b-state"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "routes": [
    {
      "pattern": "backup.navixasa.com",
      "custom_domain": true
    }
  ]
}
